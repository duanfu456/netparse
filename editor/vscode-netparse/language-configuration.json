    ]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*\\[(__main__|__test__(?:\\.\\d+)?|value|rule|python|python_file)\\]\\s*$",
      "end": "^\\s*\\[(?:__main__|__test__(?:\\.\\d+)?|value|rule|python|python_file)\\]\\s*$"
    }
  }
