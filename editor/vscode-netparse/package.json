{
  "name": "netparse-cmdb",
  "displayName": "netparse CMDB Template",
  "description": "netparse .cmdb 模板语法高亮、自动补全与 lint 实时诊断",
  "version": "0.4.5",
  "publisher": "netparse",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:cmdb"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cmdb",
        "aliases": [
          "netparse CMDB",
          "cmdb"
        ],
        "extensions": [
          ".np",
          ".cmdb"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cmdb",
        "scopeName": "source.cmdb",
        "path": "./syntaxes/cmdb.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "netparse CMDB",
      "properties": {
        "netparse.lintPath": {
          "type": "string",
          "default": "netparse",
          "description": "netparse 可执行文件路径（用于实时 lint 诊断）"
        },
        "netparse.execPath": {
          "type": "string",
          "default": "netparse",
          "description": "netparse 可执行文件路径（exe 完整路径 / PATH 中的命令名 / python 入口脚本包装）；lint 诊断与 [__main__] 自测试共用此路径"
        }
      }
    },
    "commands": [
      {
        "command": "netparse.runSelftest",
        "title": "netparse: 运行 [__main__] 自测试"
      },
      {
        "command": "netparse.exportSelftestJson",
        "title": "netparse: 导出上次自测试的完整 JSON"
      }
    ],
    "snippets": [
      {
        "language": "cmdb",
        "path": "./snippets/cmdb.json"
      }
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/duanfu456/netparse.git"
  }
}