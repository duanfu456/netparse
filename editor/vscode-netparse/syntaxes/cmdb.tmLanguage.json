{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "netparse CMDB",
  "scopeName": "source.cmdb",
  "patterns": [
    { "include": "#comment" },
    { "include": "#section-header" },
    { "include": "#collection-decl" },
    { "include": "#field-decl" },
    { "include": "#import-line" },
    { "include": "#target-line" },
    { "include": "#rule-line" },
    { "include": "#python-file-ref" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "match": "^\\s*#.*$",
          "name": "comment.line.number-sign.cmdb"
        }
      ]
    },
    "section-header": {
      "match": "^\\s*(\\[value\\]|\\[vlaue\\]|\\[rule\\]|\\[python\\]|\\[python_file\\])\\s*$",
      "captures": {
        "1": { "name": "keyword.control.section.cmdb" }
      }
    },
    "collection-decl": {
      "match": "^([A-Z]\\w*)\\s+(type\\((?:list|dict)\\))((?:\\s+start\\([^)]*\\))?)(?:\\s+(end\\([^)]*\\)))?(?:\\s+(end_indent\\(\\d+\\)))?(?:\\s+(indent\\(\\d+\\)))?(?:\\s+(desc\\([^)]*\\)))?.*$",
      "captures": {
        "1": { "name": "entity.name.type.cmdb" },
        "2": { "name": "storage.type.cmdb" },
        "3": { "name": "support.function.cmdb" },
        "4": { "name": "support.function.cmdb" },
        "5": { "name": "support.function.cmdb" },
        "6": { "name": "support.function.cmdb" },
        "7": { "name": "string.quoted.double.cmdb" }
      }
    },
    "field-decl": {
      "comment": "[value] 段字段声明：名字 type(...) [func=...] [option(...)] [default(...)] [desc(...)]",
      "match": "^\\s+(\\w+)\\s+(type\\([^)]*\\))((?:\\s+func=\\S+)?)(?:\\s+(option\\([^)]*\\)))?(?:\\s+(default\\([^)]*\\)))?(?:\\s+(desc\\([^)]*\\)))?.*$",
      "captures": {
        "1": { "name": "variable.other.member.cmdb" },
        "2": { "name": "storage.type.cmdb" },
        "3": { "name": "support.function.cmdb" },
        "4": { "name": "keyword.other.flag.cmdb" },
        "5": { "name": "constant.numeric.cmdb" },
        "6": { "name": "string.quoted.double.cmdb" }
      }
    },
    "import-line": {
      "comment": "模块化：import x / from x import *|A,B（.cmdb 后缀可省略）",
      "match": "^(import\\s+\\S+|from\\s+\\S+\\s+import\\s+.*)$",
      "name": "keyword.control.import.cmdb"
    },
    "target-line": {
      "comment": "-> target 行：In{...};Out{...} / Field=常量 / Out{Cir=In.Cir}",
      "match": "^\\s*->\\s*(.*)$",
      "captures": {
        "1": { "patterns": [
          { "include": "#field-ref" },
          { "include": "#target-members" },
          { "include": "#target-assign" }
        ] }
      }
    },
    "target-members": {
      "comment": "集合名{成员,...} 形态",
      "match": "([A-Za-z_][\\w.]*)\\{([^}]*)\\}",
      "captures": {
        "1": { "name": "entity.name.function.target.cmdb" },
        "2": { "patterns": [ { "include": "#field-ref" } ] }
      }
    },
    "target-assign": {
      "match": "(\\w+)=(\\S+)",
      "captures": {
        "1": { "name": "variable.parameter.cmdb" },
        "2": { "name": "constant.other.cmdb" }
      }
    },
    "field-ref": {
      "match": "\\$\\{[A-Za-z_][\\w.]*\\}",
      "name": "variable.other.readwrite.fieldref.cmdb"
    },
    "rule-line": {
      "comment": "[rule] 段规则行：^ 开头（含多行续行与负向断言）",
      "match": "^\\s+\\^.*$|^\\s+\\(\\?:.*$|^\\s+\\).*@$|^\\s+\\(?!.*$",
      "name": "string.regexp.ruleline.cmdb"
    },
    "python-file-ref": {
      "match": "^\\s*transforms[\\w.]*\\.py$|^\\s*\\w+[\\w/]*\\.py$",
      "name": "string.unquoted.pyfile.cmdb"
    }
  }
}
