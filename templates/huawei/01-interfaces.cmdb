# ── 接口 ──────────────────────────────────────────────
# 现网口径（318 台）：interface 块 233,666 个
#   Eth-Trunk 系列为主（其中大量是 Eth-TrunkN.MMM 子接口），
#   其次 GigabitEthernet / Vlanif / LoopBack / Virtual-Template
[python_file]
transforms_huawei.py

Interfaces type(list) start(^interface\s+) end(^#$) end_indent(0) desc(接口集合)
[value]
Name          type(str)  reg(\S+) desc(接口名) option(Key)
# Type（接口类型）：现网 21,427 个接口 100% 是 default(unknown) ——
# 没有任何规则写它，这是上一轮审查漏掉的「default 造假」第 7 例。
# 接口类型应由资产层从 Name 派生（Eth-Trunk/GigabitEthernet/Vlanif…），
# 引擎层不臆造。等 transform 能力落地后再删这个字段。
Type          type(str)  func=iface_type desc(接口类型；由 iface_type 从 Name 派生)
AdminStatus   type(str)  default(up) reg(up|down) desc(管理状态)
Description   type(str)  reg(.+) desc(描述)
Mtu           type(int)  reg(\d+) desc(MTU)
Speed         type(str)  reg(\S+) desc(速率)
Duplex        type(str)  reg(\S+) desc(双工)
VlanType      type(str)  reg(\S+) desc(VLAN 封装类型)
Dot1qVlan     type(int)  reg(\d+) desc(外层 VLAN)
UserVlan      type(list) desc(用户 VLAN 范围)
  Start     type(int) reg(\d+) desc(起始 VLAN)
  End       type(int) reg(\d+) desc(结束 VLAN)
  QinQOuter type(int) reg(\d+) desc(QinQ 外层起始)
  QinQInner type(int) reg(\d+) desc(QinQ 内层起始)
CarrierDownHoldTime type(int) reg(\d+) desc(掉线保持时间)
# `dcn`：接口块里全库只出现过 `undo dcn`（2,544 次），裸 `dcn` 0 次。
# 没出现 = 未配置，不能臆造 false —— 旧模板 default(false) 让 18,883 条
# 从未配置过 DCN 的接口全部标成 false，属于造假。
Dcn           type(bool) desc(DCN 特性)
IpBindingVpn  type(str)  reg(\S+) desc(绑定 VPN 实例)
IpUrpf        type(str)  reg(\S+) desc(uRPF 模式)
Ipv6Enable    type(bool) desc(IPv6 使能；`ipv6 enable` 全库 4,246 次 / 21,427 接口)
AccessDelay   type(int)  reg(\d+) desc(接入延迟)
DelayMode     type(str)  reg(\S+) desc(延迟模式)
PppoeTemplate type(str)  reg(\S+) desc(PPPoE 绑定的 Virtual-Template)
EthTrunk      type(str)  reg(\S+) desc(所属聚合口)
LacpMode      type(str)  reg(\S+) desc(LACP 模式)
LacpTimeout   type(str)  reg(\S+) desc(LACP 超时)
Statistic     type(dict) desc(流量统计)
  Enable type(bool) desc(统计开关)
  Mode   type(str)  reg(\S+) desc(统计模式)
QosCar        type(dict) desc(接口限速)
  Cir        type(int) reg(\d+) desc(CIR kbps)
  Pir        type(int) reg(\d+) desc(PIR kbps)
  Cbs        type(int) reg(\d+) desc(CBS 字节)
  Pbs        type(int) reg(\d+) desc(PBS 字节)
  InboundCir type(int) reg(\d+) desc(入方向 CIR)
  OutboundCir type(int) reg(\d+) desc(出方向 CIR)
QosProfile    type(str)  reg(\S+) desc(绑定 QoS Profile)
TrafficPolicy type(list) desc(流量策略)
  Name      type(str) reg(\S+) desc(策略名)
  Direction type(str) reg(\S+) desc(方向)
Pim           type(dict) desc(PIM)
  Mode       type(str)  reg(\S+) desc(PIM 模式)
  DrPriority type(int) reg(\d+) desc(DR 优先级)
  HelloInterval type(int) reg(\d+) desc(Hello 间隔)
Igmp          type(dict) desc(IGMP)
  Enable     type(bool) desc(IGMP 使能)
  StaticGroup type(str) reg(\S+) desc(静态组)
  Version    type(int) reg(\d+) desc(版本)
Isis          type(dict) desc(ISIS)
  Enable        type(int) reg(\d+) desc(进程号)
  HelloInterval type(int) reg(\d+) desc(Hello 间隔秒)
  CircuitType   type(str) reg(\S+) desc(电路类型)
  CircuitLevel  type(str) reg(\S+) desc(电路层级)
  Cost          type(int) reg(\d+) desc(开销)
  Ipv6Enable    type(bool) desc(ISIS IPv6)
  Ipv6Cost      type(int) reg(\d+) desc(ISIS IPv6 开销)
  LdpSync       type(bool) desc(LDP Sync)
  LdpSyncTimer  type(str) reg(\S+) desc(LDP Sync 定时器)
  AuthMode      type(str) reg(\S+) desc(认证模式)
  Authentication type(dict) desc(认证)
    Mode    type(str) reg(\S+) desc(认证模式)
    Algorithm type(str) reg(\S+) desc(算法)
Vrrp          type(list) desc(VRRP)
  Vrid      type(int) reg(\d+) desc(VRID)
  Priority  type(int) reg(\d+) desc(优先级)
  VirtualIp type(list) desc(虚拟 IP)
    Address type(str) reg(\S+) desc(虚拟地址)
Track         type(list) desc(track)
  Kind      type(str) reg(\S+) desc(类型)
  Target    type(str) reg(\S+) desc(目标)
  DownWeight type(int) reg(\d+) desc(联动降权值)
DefaultPasswordTemplate type(str) reg(\S+) desc(默认密码模板)
DhcpSelect    type(str)  reg(\S+) desc(DHCP 服务器组)
L2Binding     type(str)  reg(.+) desc(L2 绑定)
TrustUpstream type(str)  reg(.+) desc(信任上游)
Mpls          type(bool) desc(MPLS 使能；`mpls` 全库 643 次)
MplsLdp       type(bool) desc(MPLS LDP 使能；`mpls ldp` 全库 522 次)
MplsL2vc      type(str)  reg(.+) desc(MPLS L2VC)
Ipv6Mtu       type(int)  reg(\d+) desc(IPv6 MTU)
ControlFlap   type(bool) desc(控制翻转；`control-flap` 全库 15 次)
OspfAuthMode  type(str)  reg(.+) desc(OSPF 认证模式)
OspfNetworkType type(str) reg(\S+) desc(OSPF 网络类型)
OspfCost      type(int)  reg(\d+) desc(OSPF 开销)
OspfTimer     type(str)  reg(\S+) desc(OSPF 定时器)
MplsLdpTimer  type(str)  reg(\S+) desc(MPLS LDP 定时器)
IpRelayAddress type(str) reg(\S+) desc(IP 中继地址)
NasLogicInterface type(str) reg(.+) desc(NAS 逻辑口（接口本级）)
NasLogicAddress type(str) reg(\S+) desc(NAS 逻辑 IP（接口本级）)
PortObserving type(str)  reg(\S+) desc(端口观测)
PortMirroring type(str)  reg(\S+) desc(端口镜像方向)
Negotiation   type(str)  reg(\S+) desc(自协商)
ForwardMode   type(str)  reg(\S+) desc(转发模式)
MacAddress    type(str)  reg([\w-]+) desc(静态 MAC)
[rule]
^interface\s+${Name}\s*$

# ── 接口本级命令（缩进 1）─────────────────────────────
# 以下规则全部靠 indent(1) 限定在「恰好 1 个前导空格」的行上。
# 注意不能在这里再声明 indent()，缩进锚定是集合级属性，
# 所以这一组规则与 bas 正文规则分属两个集合（见下方 Bas）。
^ {1}description\s+${Description}\s*$
^ {1}mtu\s+${Mtu}\s*$
^ {1}speed\s+${Speed}\s*$
^ {1}duplex\s+${Duplex}\s*$
^ {1}undo shutdown\s*$          -> AdminStatus=up
^ {1}shutdown\s*$               -> AdminStatus=down
^ {1}undo dcn\s*$               -> Dcn=false
^ {1}dcn\s*$                    -> Dcn=true
^ {1}vlan-type\s+${VlanType}\s+${Dot1qVlan}\s*$
^ {1}user-vlan\s+${UserVlan.Start}(?:\s+${UserVlan.End})?(?:\s+qinq\s+${UserVlan.QinQOuter}(?:\s+${UserVlan.QinQInner})?)?\s*$
^ {1}carrier down-hold-time\s+${CarrierDownHoldTime}\s*$
^ {1}ip binding vpn-instance\s+${IpBindingVpn}\s*$
^ {1}ip urpf\s+${IpUrpf}\s*$
^ {1}ipv6 enable\s*$            -> Ipv6Enable=true
^ {1}undo ipv6 enable\s*$       -> Ipv6Enable=false
^ {1}pppoe-server bind Virtual-Template\s+${PppoeTemplate}\s*$
^ {1}eth-trunk\s+${EthTrunk}\s*$
^ {1}mode\s+${LacpMode}\s*$
^ {1}lacp timeout\s+${LacpTimeout}\s*$
^ {1}statistic enable\s*$        -> Statistic.Enable=true
^ {1}statistic mode\s+${Statistic.Mode}\s*$
^ {1}qos car cir\s+${QosCar.Cir}(?:\s+pir\s+${QosCar.Pir})?(?:\s+cbs\s+${QosCar.Cbs})?(?:\s+pbs\s+${QosCar.Pbs})?\s*$
^ {1}qos-profile\s+${QosProfile}\s*$
^ {1}traffic-policy\s+${TrafficPolicy.Name}\s+${TrafficPolicy.Direction}\s*$
^ {1}pim\s+${Pim.Mode}\s*$
^ {1}pim hello-option dr-priority\s+${Pim.DrPriority}\s*$
^ {1}igmp enable\s*$             -> Igmp.Enable=true
^ {1}isis enable\s+${Isis.Enable}\s*$
^ {1}isis circuit-type\s+${Isis.CircuitType}\s*$
^ {1}isis circuit-level\s+${Isis.CircuitLevel}\s*$
^ {1}isis cost\s+${Isis.Cost}\s*$
^ {1}isis ipv6 enable(?:\s+\d+)?\s*$   -> Isis.Ipv6Enable=true
^ {1}isis ldp-sync\s*$           -> Isis.LdpSync=true
^ {1}isis timer\s+${Isis.HelloInterval}\s*$
^ {1}default-password-template\s+${DefaultPasswordTemplate}\s*$
^ {1}dhcp select\s+${DhcpSelect}\s*$
^ {1}l2 binding\s+${L2Binding}\s*$
^ {1}trust upstream\s+${TrustUpstream}\s*$
^ {1}mpls\s*$                    -> Mpls=true
^ {1}mpls ldp\s*$                -> MplsLdp=true
^ {1}mpls l2vc\s+${MplsL2vc}\s*$
^ {1}ipv6 mtu\s+${Ipv6Mtu}\s*$
^ {1}igmp static-group\s+${Igmp.StaticGroup}\s*$
^ {1}control-flap\s*$            -> ControlFlap=true
^ {1}ospf authentication-mode\s+${OspfAuthMode}\s*$
^ {1}vrrp vrid\s+(?P<Vrid>\d+)\s+priority\s+(?P<Priority>\d+)\s*$
       -> Vrrp{Vrid,Priority}
^ {1}vrrp vrid\s+(?P<Vrid>\d+)\s+virtual-ip\s+(?P<Address>\S+)\s*$
       -> Vrrp{Vrid,VirtualIp{Address}}
# 真实形态（3,291 次，只有 1 种）：
#     track monitor-group JianKong trigger-down-weight 100
# 即 `track <Kind> <Target> [trigger-down-weight N]`，**没有数字 ID**。
# 旧模板写 `track ${Id} ${Type} ${Target}` 要求第二个 token 是数字，全库 0 命中。
^ {1}track\s+(?P<Kind>\S+)(?:\s+(?P<Target>\S+))?(?:\s+trigger-down-weight\s+(?P<DownWeight>\d+))?\s*$
       -> Track{Kind,Target,DownWeight}
# `ip relay address` 缩进 1，只有这一种形态（165 次）。
# 它曾挂在 IpAddress 集合下，靠栈里残留的 IpAddress 帧顺带命中；
# 接口里没有 `ip address` 时 IpAddress 帧不存在 → 漏掉（实测 6 行）。
^ {1}ip relay address\s+${IpRelayAddress}\s*$
# `nas logic-port` / `nas logic-ip` 在缩进 1（接口本级）与缩进 2（bas 视图）都出现，
# 两个缩进分属 Interfaces 与 Bas 两个集合，规则各写一份。
^ {1}nas logic-port\s+${NasLogicInterface}\s*$
       -> NasLogicInterface
^ {1}nas logic-ip\s+${NasLogicAddress}\s*$
^ {1}port-observing\s+${PortObserving}\s*$
^ {1}isis ipv6 cost\s+${Isis.Ipv6Cost}(?:\s+level-\d+)?\s*$
^ {1}isis timer ldp-sync\s+${Isis.LdpSyncTimer}\s*$
^ {1}isis authentication-mode\s+${Isis.AuthMode}\s*$
^ {1}mpls ldp timer\s+${MplsLdpTimer}\s*$
^ {1}ospf network-type\s+${OspfNetworkType}\s*$
^ {1}ospf cost\s+${OspfCost}\s*$
^ {1}ospf timer\s+${OspfTimer}\s*$
^ {1}port-mirroring\s+${PortMirroring}\s*$
^ {1}negotiation\s+${Negotiation}\s*$
^ {1}forward-mode\s+${ForwardMode}\s*$
^ {1}mac-address\s+${MacAddress}\s*$

  # ── 接口 IP（子层）────────────────────────────────
  # 不声明 end：IpAddress 只承载 `ip address` / `ipv6 address` 两种行，
  # 其余缩进 1 的命令匹配不上它的规则，会自然落到 Interfaces 本层。
  # 实测即使栈里残留 IpAddress 帧，Bas 仍会按 coll.parent 正确挂到
  # Interfaces 下，所以不需要为它编造 end 正则。
  IpAddress type(list) start(^\s*ip(v6)? address) indent(1) desc(接口IP)
  [value]
  Address type(str) reg([^/\s]+) desc(地址)
  Mask    type(str) reg(\S+) desc(掩码)
  Family  type(str) reg(ipv4|ipv6) desc(地址族)
  Mode    type(str) reg(\S+) desc(自动地址模式)
  AddressType type(str) reg(sub) desc(地址类型)
  [rule]
  ^ {1}ip address\s+${Address}\s+${Mask}(?:\s+${AddressType})?\s*$   -> Family="ipv4"
  ^ {1}ipv6 address\s+${Address}/${Mask}\s*$                              -> Family="ipv6"
  ^ {1}ipv6 address\s+auto\s+${Mode}\s*$                                  -> Address="auto",Family="ipv6"

  # ── BAS 接入视图正文（缩进 2）──────────────────────
  # 缩进 2 是 bas 子视图内部，必须与接口本级的同名命令分开建模。
  # 实测缩进 2 共 53,161 行，`nas logic-port` 在缩进 1/2 都会出现。
  Bas type(dict) start(^ {1}bas\s*$) indent(2) desc(BAS 视图)
  [value]
  AccessType    type(str) reg(\S+) desc(接入类型)
  AuthDomain    type(str) reg(\S+) desc(认证域)
  PreAuthDomain type(str) reg(\S+) desc(预认证域)
  Method        type(str) reg(\S+) desc(认证方式)
  NasLogicIp    type(list) desc(NAS 逻辑 IP)
    Address type(str) reg(\S+) desc(逻辑 IP)
  NasLogicPort  type(list) desc(NAS 逻辑口)
    Interface type(str) reg(.+) desc(逻辑接口)
  Option82      type(str) reg(.+) desc(Option82 插入)
  # 10,462 个 bas 块里 arp-trigger 只出现 2,582 次（24.7%）、ip-trigger 2,570、
  # arp-proxy 2,509 → 不给默认值，没出现就留空，不臆造 true。
  ArpTrigger    type(bool) desc(ARP 触发)
  IpTrigger     type(bool) desc(IP 触发)
  ArpProxy      type(bool) desc(ARP 代理)
  AccessDelay   type(int) reg(\d+) desc(接入延迟)
  DelayMode     type(str) reg(\S+) desc(延迟模式)
  UserDetect    type(dict) desc(用户探测)
    Retransmit type(int) reg(\d+) desc(重传次数)
    Interval   type(int) reg(\d+) desc(间隔秒)
  VpnInstance   type(str) reg(\S+) desc(认证 VPN 实例)
  DefaultPasswordTemplate type(str) reg(\S+) desc(默认密码模板)
  NasPortType   type(str) reg(\S+) desc(NAS 端口类型)
  [rule]
  ^ {2}access-type\s+${AccessType}\s+default-domain\s+authentication\s+${AuthDomain}\s*$
        -> AccessType,AuthDomain
  ^ {2}access-type\s+${AccessType}\s+default-domain\s+pre-authentication\s+${PreAuthDomain}\s*$
        -> AccessType,PreAuthDomain
  ^ {2}access-type\s+${AccessType}\s*$
  ^ {2}authentication-method\s+${Method}\s*$
  ^ {2}nas logic-ip\s+${NasLogicIp.Address}\s*$
  ^ {2}nas logic-port\s+${NasLogicPort.Interface}\s*$
  ^ {2}client-option82\s+${Option82}\s*$
  ^ {2}access-delay\s+${AccessDelay}(?:\s+${DelayMode})?\s*$
  ^ {2}arp-trigger\s*$        -> ArpTrigger=true
  ^ {2}ip-trigger\s*$         -> IpTrigger=true
  ^ {2}arp-proxy\s*$          -> ArpProxy=true
  ^ {2}user detect retransmit\s+${UserDetect.Retransmit}\s+interval\s+${UserDetect.Interval}\s*$
  ^ {2}vpn-instance\s+${VpnInstance}\s*$
  # `default-password-template` 只在 bas 正文出现（缩进 2，共 2,406 次，
  # 仅 iptv / ottx 两个值）；接口本级的同名命令不存在，故只写这一份。
  ^ {2}default-password-template\s+${DefaultPasswordTemplate}\s*$
  ^ {2}nas-port-type\s+${NasPortType}\s*$
